class Stack {
    int stack[] = new int[3];
    int top = -1;

    void push(int x) {
        try {
            if (top == 2)
                throw new Exception("Stack Overflow");
            stack[++top] = x;
            System.out.println(x + " pushed");
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }

    void pop() {
        try {
            if (top == -1)
                throw new Exception("Stack Underflow");
            System.out.println(stack[top--] + " popped");
        } catch (Exception e) {
            System.out.println(e.getMessage());
        }
    }
}

public class Main {
    public static void main(String[] args) {
        Stack s = new Stack();

        s.push(10);
        s.push(20);
        s.pop();
        s.pop();
        s.pop();
    }
}
