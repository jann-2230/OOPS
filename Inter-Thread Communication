class Shared {
    int value;
    boolean available = false;

    synchronized void produce(int n) {
        try {
            while (available)
                wait();

            value = n;
            System.out.println("Produced: " + value);

            available = true;
            notify();
        } catch (Exception e) {
            System.out.println(e);
        }
    }

    synchronized void consume() {
        try {
            while (!available)
                wait();

            System.out.println("Consumed: " + value);

            available = false;
            notify();
        } catch (Exception e) {
            System.out.println(e);
        }
    }
}

class Producer extends Thread {
    Shared s;

    Producer(Shared s) {
        this.s = s;
    }

    public void run() {
        for (int i = 1; i <= 5; i++)
            s.produce(i);
    }
}

class Consumer extends Thread {
    Shared s;

    Consumer(Shared s) {
        this.s = s;
    }

    public void run() {
        for (int i = 1; i <= 5; i++)
            s.consume();
    }
}

public class Main {
    public static void main(String[] args) {
        Shared s = new Shared();

        Producer p = new Producer(s);
        Consumer c = new Consumer(s);

        p.start();
        c.start();
    }
}
