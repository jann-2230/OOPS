import java.io.*;

public class Main {
    public static void main(String[] args) {
        try {
            FileWriter f = new FileWriter("test.txt");
            f.write("Welcome to Java");
            f.close();

            FileReader r = new FileReader("test.txt");
            int ch;

            while ((ch = r.read()) != -1)
                System.out.print((char) ch);

            r.close();
        } catch (Exception e) {
            System.out.println(e);
        }
    }
}
